# Razorpay test-mode keys — get from dashboard.razorpay.com > API Keys > Test Mode
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXX

# LLM — OpenAI-compatible. Works with OpenAI, Gemini, Groq, etc.
# For OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
# For Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# For Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# SQLite file path (relative to repo root)
DATABASE_URL=./triage.db

# Base URL for payment link callbacks (use ngrok / localtunnel in dev)
APP_BASE_URL=http://localhost:3000
