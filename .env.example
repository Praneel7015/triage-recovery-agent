# Razorpay test-mode keys — dashboard.razorpay.com > API Keys > Test Mode
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXX

# LLM — OpenAI-compatible. Groq compound-mini is the tested model.
# Do not send response_format=json_object to Groq; the client extracts JSON itself.
# For Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=groq/compound-mini
# For OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#               LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=groq/compound-mini

# SQLite file path (relative to repo root)
DATABASE_URL=./triage.db

# Public base URL for Payment Link callbacks (ngrok / Cloudflare tunnel in dev)
APP_BASE_URL=http://localhost:3000
